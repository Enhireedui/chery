# ══════════════════════════════════════════════════════════════
#  CHERY Mongolia — орчны хувьсагчид
#  Энэ файлыг `.env.local` болгон хуулж, бодит утгыг бөглөнө.
#  ⚠ `.env.local` нь `.gitignore`-д байгаа — БОДИТ УТГЫГ ЭНД БИЧИХГҮЙ.
# ══════════════════════════════════════════════════════════════

# ── Сайтын бүрэн хаяг ──
# canonical, og:url, sitemap, robots бүгд үүнээс уншина.
# Локал: http://localhost:3000
# Production: https://chery.mn
# Vercel preview-д тохируулахгүй бол Vercel өөрөө VERCEL_URL-ыг өгнө.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──
# Supabase → Project Settings → API-аас авна.
#
# `NEXT_PUBLIC_` угтвартай хувьсагч нь ХӨТӨЧИД ХҮРНЭ. Тиймээс
# зөвхөн ил тод байж болох утга л энэ угтвартай байна. anon key нь
# RLS-ээр хамгаалагдсан тул ил тод байж болно.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ⚠⚠ SERVICE ROLE KEY — RLS-ийг БҮТНЭЭР ДАВДАГ.
# · `NEXT_PUBLIC_` угтвар ХЭЗЭЭ Ч тавихгүй
# · client component-д импортлохгүй
# · зөвхөн server (route handler / server action) дээр уншина
# · Vercel-д зөвхөн Production ба Preview дээр тохируулна
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Маягтын спам хамгаалалт (заавал биш) ──
# Cloudflare Turnstile. Хоосон бол Turnstile шалгалт алгасагдаж,
# honeypot + rate limit хоёр л үйлчилнэ.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
